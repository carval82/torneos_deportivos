# APP_DEBUG=false
# APP_URL=https://tu-servicio.up.railway.app
# APP_KEY=base64:...   (php artisan key:generate --show)
# DB_CONNECTION=pgsql
# DATABASE_URL=${{Postgres.DATABASE_URL}}
# LOG_LEVEL=error
#
# Ayuda (botón ¿Cómo se hace?)
# ASISTENTE_ENABLED=true
# ASISTENTE_FRAME_URL=https://chatbot-production-ab9d.up.railway.app/w/arena-ayuda
